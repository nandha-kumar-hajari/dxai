---
// Man-page SEE ALSO: a two-column index of the docs, not a wall of cards.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
  { term: 'guide/quick-start', body: 'Zero to configured in two minutes', href: `${base}/guide/quick-start/` },
  { term: 'guide/non-interactive', body: 'Flags, JSON output, exit codes, CI recipes', href: `${base}/guide/non-interactive/` },
  { term: 'guide/profiles', body: 'Reusable setups for you and your team', href: `${base}/guide/profiles/` },
  { term: 'guide/introspection', body: 'list, status, doctor — drift detection', href: `${base}/guide/introspection/` },
  { term: 'reference/commands', body: 'Every subcommand and flag, generated from the CLI itself', href: `${base}/reference/commands/` },
  { term: 'registry/mcp-servers', body: 'The bundled MCP catalog, per-agent support', href: `${base}/registry/mcp-servers/` },
  { term: 'registry/custom-registry', body: 'Host your own catalog fork', href: `${base}/registry/custom-registry/` },
  { term: 'internals/development', body: 'Maintainer notes: dev loop, testing, releasing', href: `${base}/internals/development/` },
];
---

<section class="dx-section dx-section--last" aria-labelledby="dx-seealso-title">
  <h2 id="dx-seealso-title" class="dx-mansec">See also</h2>

  <ul class="dx-see-list">
    {links.map((l) => (
      <li class="dx-see-item">
        <a class="dx-see-link" href={l.href}>
          <span class="dx-see-term">{l.term}</span>
          <span class="dx-see-body">{l.body}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .dx-see-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--dx-hairline);
  }

  @media (min-width: 56rem) {
    .dx-see-list {
      grid-template-columns: 1fr 1fr;
      column-gap: 3.5rem;
    }
  }

  .dx-see-item {
    border-bottom: 1px solid var(--dx-hairline);
  }

  .dx-see-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.85rem 0.25rem;
    text-decoration: none;
    transition: background 150ms ease;
  }

  .dx-see-link:hover,
  .dx-see-link:focus-visible {
    background: color-mix(in srgb, var(--dx-accent) 6%, transparent);
  }

  .dx-see-link:focus-visible {
    outline: 2px solid var(--dx-accent);
    outline-offset: -2px;
  }

  .dx-see-term {
    font-family: var(--dx-mono);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--dx-accent);
  }

  .dx-see-link:hover .dx-see-term {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .dx-see-body {
    font-size: 0.88rem;
    color: var(--dx-muted);
  }
</style>
