---
import { Icon } from 'astro-icon/components';

// Supported agents as a quiet index: logo, name, and the real config
// destination dxai writes for each. Hairline rows, no cards.
// Codex maps to `simple-icons:openai` (Codex is OpenAI's product); Antigravity
// isn't in Simple Icons yet, so the generic Google mark + label disambiguates.
const tools = [
  { name: 'Cursor', icon: 'simple-icons:cursor', path: '~/.cursor/mcp.json' },
  { name: 'Claude Code', icon: 'simple-icons:claude', path: 'claude mcp add' },
  { name: 'VS Code / Copilot', icon: 'simple-icons:visualstudiocode', path: '…/Code/User/mcp.json' },
  { name: 'Codex CLI', icon: 'simple-icons:openai', path: '~/.codex/config.toml' },
  { name: 'Gemini CLI', icon: 'simple-icons:googlegemini', path: '~/.gemini/settings.json' },
  { name: 'Windsurf', icon: 'simple-icons:windsurf', path: '~/.codeium/windsurf/mcp_config.json' },
  { name: 'Antigravity', icon: 'simple-icons:google', path: '~/.gemini/config/mcp_config.json' },
];
---

<section class="dx-section" aria-labelledby="dx-tools-title">
  <h2 id="dx-tools-title" class="dx-mansec">Supported agents</h2>

  <ul class="dx-tools-list">
    {tools.map((t) => (
      <li class="dx-tools-row">
        <span class="dx-tools-glyph" aria-hidden="true"><Icon name={t.icon} /></span>
        <span class="dx-tools-name">{t.name}</span>
        <span class="dx-tools-path">{t.path}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .dx-tools-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--dx-hairline);
  }

  .dx-tools-row {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr);
    gap: 0 0.9rem;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--dx-hairline);
  }

  @media (min-width: 48rem) {
    .dx-tools-row {
      grid-template-columns: 1.6rem 14rem minmax(0, 1fr);
    }
  }

  .dx-tools-glyph {
    display: inline-flex;
    color: var(--dx-muted);
  }

  .dx-tools-glyph svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .dx-tools-name {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--dx-ink);
  }

  .dx-tools-path {
    font-family: var(--dx-mono);
    font-size: 0.8rem;
    color: var(--dx-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 48rem) {
    .dx-tools-path {
      grid-column: 2;
    }
  }
</style>
