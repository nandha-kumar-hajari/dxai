---
import { Icon } from 'astro-icon/components';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const paths = [
  {
    title: 'Quick Start',
    icon: 'lucide:zap',
    body: 'Get from zero to a configured environment in two minutes.',
    href: `${base}/guide/quick-start/`,
  },
  {
    title: 'Non-interactive / CI',
    icon: 'lucide:terminal',
    body: 'Flags, env vars, JSON output, dry-run.',
    href: `${base}/guide/non-interactive/`,
  },
  {
    title: 'Profiles',
    icon: 'lucide:user-cog',
    body: 'Save and apply reusable setups for yourself or your team.',
    href: `${base}/guide/profiles/`,
  },
  {
    title: 'CLI Reference',
    icon: 'lucide:book-open',
    body: 'Every subcommand and flag, auto-generated.',
    href: `${base}/reference/commands/`,
  },
  {
    title: 'MCP Servers',
    icon: 'lucide:plug',
    body: 'The bundled catalog of MCP servers and which agents support each.',
    href: `${base}/registry/mcp-servers/`,
  },
  {
    title: 'Custom registry',
    icon: 'lucide:package',
    body: 'Host your own registry, or fork the bundled one.',
    href: `${base}/registry/custom-registry/`,
  },
];
---

<section class="dxai-section dx-paths" aria-labelledby="dx-paths-title">
  <span class="dxai-section-eyebrow">Dive deeper</span>
  <h2 id="dx-paths-title" class="dxai-section-title">Pick your path</h2>
  <p class="dxai-section-subtitle">
    From a two-minute quick-start to writing your own registry — the docs are organized so you can jump to what you need.
  </p>

  <ul class="dx-paths-grid">
    {paths.map((p) => (
      <li class="dx-paths-card-wrap">
        <a class="dx-paths-card" href={p.href}>
          <span class="dx-paths-glyph" aria-hidden="true">
            <Icon name={p.icon} />
          </span>
          <div class="dx-paths-text">
            <h3 class="dx-paths-title">
              {p.title}
              <span class="dx-paths-arrow" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="14" height="14">
                  <path
                    d="M6 3.5L10.5 8L6 12.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </h3>
            <p class="dx-paths-body">{p.body}</p>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .dx-paths-grid {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 56rem) {
    .dx-paths-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }

  .dx-paths-card-wrap {
    display: flex;
  }

  .dx-paths-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    width: 100%;
    padding: 1.4rem 1.5rem;
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, #0ea5e9 22%, transparent);
    background:
      radial-gradient(
        120% 100% at 0% 0%,
        color-mix(in srgb, #0ea5e9 8%, transparent) 0%,
        transparent 55%
      ),
      color-mix(in srgb, var(--sl-color-bg) 90%, #0ea5e9 4%);
    color: var(--sl-color-text);
    text-decoration: none;
    position: relative;
    overflow: hidden;
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }

  .dx-paths-card::after {
    content: '';
    position: absolute;
    inset: auto -40% -60% auto;
    width: 70%;
    height: 70%;
    background: radial-gradient(circle, color-mix(in srgb, #0ea5e9 18%, transparent) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 250ms ease;
    pointer-events: none;
  }

  .dx-paths-card:hover,
  .dx-paths-card:focus-visible {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, #0ea5e9 55%, transparent);
    box-shadow: 0 12px 36px -16px color-mix(in srgb, #0ea5e9 55%, transparent);
    outline: none;
  }

  .dx-paths-card:focus-visible {
    outline: 2px solid #0ea5e9;
    outline-offset: 2px;
  }

  .dx-paths-card:hover::after,
  .dx-paths-card:focus-visible::after {
    opacity: 1;
  }

  .dx-paths-glyph {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 10px;
    background: color-mix(in srgb, #0ea5e9 14%, transparent);
    border: 1px solid color-mix(in srgb, #0ea5e9 28%, transparent);
    color: #0ea5e9;
    transition: background 200ms ease, border-color 200ms ease, transform 200ms ease;
  }

  .dx-paths-glyph svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .dx-paths-card:hover .dx-paths-glyph,
  .dx-paths-card:focus-visible .dx-paths-glyph {
    background: color-mix(in srgb, #0ea5e9 24%, transparent);
    border-color: color-mix(in srgb, #0ea5e9 60%, transparent);
    transform: scale(1.05);
  }

  .dx-paths-text {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
    flex: 1;
  }

  .dx-paths-title {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
    line-height: 1.3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .dx-paths-arrow {
    display: inline-flex;
    color: color-mix(in srgb, #0ea5e9 70%, transparent);
    transition: transform 220ms ease, color 220ms ease;
  }

  .dx-paths-card:hover .dx-paths-arrow,
  .dx-paths-card:focus-visible .dx-paths-arrow {
    transform: translateX(3px);
    color: #0ea5e9;
  }

  .dx-paths-body {
    margin: 0;
    color: color-mix(in srgb, var(--sl-color-text) 70%, transparent);
    font-size: 0.9rem;
    line-height: 1.55;
  }
</style>
