---
import { Icon } from 'astro-icon/components';

const features = [
  {
    title: 'One config, every tool',
    icon: 'lucide:settings-2',
    body: 'Pick an MCP server once and dxai writes the right config in the right format for Cursor, Claude Code, VS Code, Codex (TOML), Gemini, Windsurf, and Antigravity — simultaneously.',
  },
  {
    title: 'Profiles for teams',
    icon: 'lucide:users-round',
    body: 'Save your selections as a profile (`~/.dxai/profiles/<name>.json` or `./.dxai/profile.json`). Teammates run `dxai apply` and get the same environment in one command.',
  },
  {
    title: 'Drift-aware',
    icon: 'lucide:list-checks',
    body: '`dxai list` / `status` / `doctor` read a manifest of what was installed, so cleanup is precise and you can spot config drift in PR review.',
  },
  {
    title: 'CI-ready',
    icon: 'lucide:terminal-square',
    body: 'Set `CI=true` (or pass `--yes`) for fully unattended runs. JSON output mode pipes into the rest of your tooling.',
  },
];

// Render inline `code` markers in the body without pulling in a markdown parser.
function renderBody(text: string) {
  const parts = text.split(/(`[^`]+`)/g);
  return parts.map((p) =>
    p.startsWith('`') && p.endsWith('`')
      ? { code: true, value: p.slice(1, -1) }
      : { code: false, value: p },
  );
}
---

<section class="dxai-section dx-why" aria-labelledby="dx-why-title">
  <span class="dxai-section-eyebrow">Why dxai?</span>
  <h2 id="dx-why-title" class="dxai-section-title">Built for shared AI dev environments</h2>
  <p class="dxai-section-subtitle">
    Stop hand-rolling configs per editor. Define your environment once, apply it everywhere, keep it in sync.
  </p>

  <ul class="dx-why-grid">
    {features.map((f) => (
      <li class="dx-why-card">
        <span class="dx-why-glyph" aria-hidden="true">
          <Icon name={f.icon} />
        </span>
        <div class="dx-why-text">
          <h3 class="dx-why-title">{f.title}</h3>
          <p class="dx-why-body">
            {renderBody(f.body).map((part) =>
              part.code ? <code>{part.value}</code> : <Fragment>{part.value}</Fragment>,
            )}
          </p>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .dx-why-grid {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 56rem) {
    .dx-why-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  .dx-why-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.4rem 1.5rem;
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, #0ea5e9 22%, transparent);
    background:
      radial-gradient(
        120% 100% at 0% 0%,
        color-mix(in srgb, #0ea5e9 8%, transparent) 0%,
        transparent 55%
      ),
      color-mix(in srgb, var(--sl-color-bg) 90%, #0ea5e9 4%);
    color: var(--sl-color-text);
    position: relative;
    overflow: hidden;
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }

  .dx-why-card::after {
    content: '';
    position: absolute;
    inset: auto -40% -60% auto;
    width: 70%;
    height: 70%;
    background: radial-gradient(circle, color-mix(in srgb, #0ea5e9 18%, transparent) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 250ms ease;
    pointer-events: none;
  }

  .dx-why-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, #0ea5e9 55%, transparent);
    box-shadow: 0 12px 36px -16px color-mix(in srgb, #0ea5e9 55%, transparent);
  }

  .dx-why-card:hover::after {
    opacity: 1;
  }

  .dx-why-glyph {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 10px;
    background: color-mix(in srgb, #0ea5e9 14%, transparent);
    border: 1px solid color-mix(in srgb, #0ea5e9 28%, transparent);
    color: #0ea5e9;
    transition: background 200ms ease, border-color 200ms ease, transform 200ms ease;
  }

  .dx-why-glyph svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .dx-why-card:hover .dx-why-glyph {
    background: color-mix(in srgb, #0ea5e9 24%, transparent);
    border-color: color-mix(in srgb, #0ea5e9 60%, transparent);
    transform: scale(1.05);
  }

  .dx-why-text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .dx-why-title {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
    line-height: 1.3;
  }

  .dx-why-body {
    margin: 0;
    color: color-mix(in srgb, var(--sl-color-text) 75%, transparent);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .dx-why-body code {
    font-family: var(--dx-mono, ui-monospace, SFMono-Regular, monospace);
    font-size: 0.82em;
    background: color-mix(in srgb, var(--sl-color-bg) 50%, #000 50%);
    color: #7dd3fc;
    padding: 0.1rem 0.4rem;
    border-radius: 6px;
    border: 1px solid color-mix(in srgb, #0ea5e9 22%, transparent);
    white-space: nowrap;
  }
</style>
